# Server Port
PORT=8000

# MongoDB URI (Atlas or Local)
MONGO=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sendchat-db?retryWrites=true&w=majority
LOCAL_MONGO=mongodb://127.0.0.1:27017/chat-app-db

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# -------------------------------------------------------------
# Brevo (Sendinblue) Transactional Email (Recommended Free Tier)
# Free Plan: 300 emails/day to ANY email address.
# Get free API key: https://app.brevo.com/settings/keys/api
# -------------------------------------------------------------
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME="SendChat Security"

# Optional SMTP Relay (Brevo SMTP, Gmail App Password, Mailtrap, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_key_or_password
EMAIL_FROM="SendChat Security" <your_email@example.com>

# Optional Resend API (Fallback)
RESEND_API_KEY=re_your_resend_api_key

# Google Gemini AI Bot
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your_email@example.com

# -------------------------------------------------------------
# Cloudinary Media Storage (Images, Documents/PDFs, Audio Voice Notes)
# Free Plan: 25GB managed storage & bandwidth.
# Sign up free: https://cloudinary.com
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternative single-line connection URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

